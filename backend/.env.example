# ====================================
# VenridesScreenS - Backend Configuration
# ====================================
# Este es un archivo de ejemplo. Copia este archivo como .env y configura tus valores reales.
# cp .env.example .env

# ====================================
# Base de Datos
# ====================================
DATABASE_URL=postgresql+asyncpg://venrides_user:YOUR_PASSWORD_HERE@db/venrides_db

# ====================================
# Seguridad
# ====================================
# Genera una clave secreta fuerte con: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_OPENSSL_RAND_HEX_32
# Usuario maestro inicial (solo se crea si MASTER_ADMIN_PASSWORD está definida)
MASTER_ADMIN_EMAIL=nerdop@gmail.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Permite el endpoint de reparación /diag/status?repair=true (dejar en false en producción)
ALLOW_DIAG_REPAIR=false

# ====================================
# Email (Gmail SMTP)
# ====================================
SMTP_USER=your-email@gmail.com
SMTP_PORT=587
SMTP_SERVER=smtp.gmail.com
SMTP_PASSWORD=your-gmail-app-password-16-chars
NOTIFICATION_EMAIL=soporte@inverpave.com

# ====================================
# Google Sheets (Opcional)
# ====================================
# Ruta al archivo de credenciales del Service Account
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json

# ====================================
# Redis (Opcional)
# ====================================
REDIS_URL=redis://redis:6379/0

# ====================================
# Benry AI & Knowledge Base
# ====================================
# ID del documento de Google Drive con la base de conocimientos
BENRY_KNOWLEDGE_DOC_ID=your-google-doc-id
# Ruta al JSON de credenciales de Google (con permisos de Sheets y Docs)
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/google-service-account.json

# ====================================
# Producción & SEO
# ====================================
PROD_API_URL=https://venrides-api.inverpave.com
PROD_LANDING_URL=https://venrides.inverpave.com
PROD_ADMIN_URL=https://venrides-app.inverpave.com
PROD_TV_URL=https://venrides-tv.inverpave.com
PROD_ODOO_URL=https://venrides-erp.inverpave.com

# ====================================
# Social Media IDs (Opcional)
# ====================================
INSTAGRAM_ID=venrides.screens
WHATSAPP_NUMBER=584120000000

# ====================================
# Logging
# ====================================
LOG_LEVEL=info
