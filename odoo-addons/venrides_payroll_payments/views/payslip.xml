<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payslip_form_receipts" model="ir.ui.view">
        <field name="name">hr.payslip.form.receipts</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="venrides_payroll.hr_payslip_form_inherit_views_lunes"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_venrides_payslip_receipts)d" type="action"
                        string="Recibos por concepto" invisible="not line_ids"/>
            </xpath>
        </field>
    </record>
</odoo>
