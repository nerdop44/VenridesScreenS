<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Procesar cola de facturas TFHKA pendientes cada 3 minutos -->
        <record id="cron_tfhka_fiscal_queue" model="ir.cron">
            <field name="name">[LocVe] Emisión fiscal TFHKA pendiente</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._tfhka_process_fiscal_queue(20)</field>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>

            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Renovar token TFHKA cada 6 horas -->
        <record id="cron_tfhka_token_refresh" model="ir.cron">
            <field name="name">[LocVe] Renovar token TFHKA</field>
            <field name="model_id" ref="base.model_res_company"/>
            <field name="state">code</field>
            <field name="code">model._tfhka_refresh_tokens()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>

            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
