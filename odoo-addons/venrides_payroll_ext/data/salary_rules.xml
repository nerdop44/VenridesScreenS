        <!-- ===================== SEMANAL ===================== -->
        <record id="rule_BONOGUE_semanal" model="hr.salary.rule">
            <field name="name">Bono de guerra</field>
            <field name="code">BONOGUE</field>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
monto = contract.bono_guerra_usd * payslip.tasa_cambio
WORK100 = worked_days.WORK100.number_of_days if worked_days.WORK100 else 0
AUSEP = worked_days.AUSEP.number_of_days if worked_days.AUSEP else 0
result = (monto / 30) * (WORK100 + AUSEP)
            </field>
            <field name="category_id" ref="venrides_payroll.category_asignacion_bonos"/>
            <field name="sequence" eval="10"/>
            <field name="struct_id" ref="venrides_payroll.structure_semanal"/>
        </record>

