        <!-- ============ BASE DE DEDUCCIONES CONFIGURABLE ============ -->
        <record id="venrides_payroll.rule_FAOV_semanal" model="hr.salary.rule">
            <field name="amount_python_compute">
base = categories.BASIC
if employee.company_id.venrides_deduction_base_mode == 'total':
    base = categories.BASIC + categories.ASIGNA + categories.SUBS + categories.BONO
result = base * (employee.company_id.por_empleado_lph / 100)
            </field>
