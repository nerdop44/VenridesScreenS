<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_pay_form" model="ir.ui.view">
        <field name="name">hr.contract.form.pay</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="venrides_payroll.hr_contract_form_inherit_views_ve"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='venrides_remuneration']" position="inside">
                <div class="alert alert-warning" role="alert"
                     invisible="not pay_day_conflict">
                    Ya existe otro empleado con este día de pago. Verifica que sea intencional.
                </div>
                <separator string="Ciclo de pago"/>
                <group>
                    <group>
                        <field name="pay_cycle_id"/>
                        <field name="pay_frequency"/>
                    </group>
                    <group>
                        <field name="pay_day"/>
                        <field name="pay_day_conflict"/>
                        <field name="employee_account_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
