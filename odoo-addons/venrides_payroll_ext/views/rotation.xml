<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rotation_plan_list" model="ir.ui.view">
        <field name="name">venrides.rotation.plan.list</field>
        <field name="model">venrides.rotation.plan</field>
        <field name="arch" type="xml">
            <list string="Planes de rotación">
                <field name="name"/>
                <field name="code"/>
                <field name="start_date"/>
                <field name="frequency_days"/>
                <field name="duration_days"/>
                <field name="periods_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_rotation_plan_form" model="ir.ui.view">
        <field name="name">venrides.rotation.plan.form</field>
        <field name="model">venrides.rotation.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de rotación">
                <header>
                    <button name="action_generate" type="object"
                            string="Generar calendario" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="start_date"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="frequency_days"/>
                            <field name="duration_days"/>
                            <field name="periods_count"/>
                        </group>
                    </group>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="job_ids" widget="many2many_tags"/>
                    <separator string="Calendario generado"/>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'current'"
                                   decoration-muted="state == 'done'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_rotation_plan" model="ir.actions.act_window">
        <field name="name">Rotación de puestos</field>
        <field name="res_model">venrides.rotation.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
