<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medical_support_form" model="ir.ui.view">
        <field name="name">venrides.medical.support.form</field>
        <field name="model">venrides.medical.support</field>
        <field name="arch" type="xml">
            <form string="Enviar reposo / justificativo">
                <group>
                    <group>
                        <field name="employee_id"/>
                        <field name="date"/>
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="attachment" widget="binary"/>
                        <field name="filename"/>
                        <field name="send_now"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_request" type="object"
                            string="Enviar para firma" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
