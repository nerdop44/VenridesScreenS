<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sign_request_list" model="ir.ui.view">
        <field name="name">venrides.sign.request.list</field>
        <field name="model">venrides.sign.request</field>
        <field name="arch" type="xml">
            <list string="Documentos para firma">
                <field name="name"/>
                <field name="document_type"/>
                <field name="employee_id"/>
                <field name="reference"/>
                <field name="amount_usd"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'signed'"
                       decoration-warning="state in ('sent', 'otp_sent')"
                       decoration-danger="state in ('expired', 'declined')"/>
                <field name="signature_check" widget="badge"
                       decoration-success="signature_check == 'ok'"
                       decoration-warning="signature_check == 'review'"
                       decoration-danger="signature_check == 'reject'"/>
                <field name="signed_date"/>
            </list>
        </field>
    </record>

    <record id="view_sign_request_form" model="ir.ui.view">
        <field name="name">venrides.sign.request.form</field>
        <field name="model">venrides.sign.request</field>
        <field name="arch" type="xml">
            <form string="Documento para firma">
                <header>
                    <button name="action_send" type="object" string="Enviar a firma"
                            class="btn-primary" invisible="state == 'signed'"/>
                    <button name="action_open_sign_page" type="object"
                            string="Abrir firma" invisible="state == 'signed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="employee_id"/>
                            <field name="signer_email"/>
                            <field name="reference"/>
                            <field name="concept_name"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="currency_id_bs" invisible="1"/>
                            <field name="amount_usd"/>
                            <field name="rate_bs_usd"/>
                            <field name="amount_bs"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="expiry_date"/>
                            <field name="sign_url" widget="url"/>
                            <field name="verify_url" widget="url"/>
                            <field name="qr_url" widget="url"/>
                        </group>
                        <group>
                            <field name="signature_check"/>
                            <field name="signature_similarity"/>
                            <field name="signature_point_count"/>
                            <field name="signature_duration_ms"/>
                            <field name="signed_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documentos" name="documents">
                            <group>
                                <field name="pdf_unsigned" widget="binary"/>
                                <field name="pdf_signed" widget="binary"/>
                                <field name="support" widget="binary"/>
                                <field name="support_filename"/>
                            </group>
                        </page>
                        <page string="Firma y evidencia" name="signature">
                            <group>
                                <field name="signature_image" widget="image"/>
                                <field name="signature_hash"/>
                                <field name="signature_dhash"/>
                                <field name="content_hash"/>
                                <field name="signed_pdf_hash"/>
                                <field name="signature_ip"/>
                                <field name="signature_user_agent"/>
                            </group>
                            <field name="signature_strokes" readonly="1"/>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_sign_request" model="ir.actions.act_window">
        <field name="name">Firmas y documentos</field>
        <field name="res_model">venrides.sign.request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
