<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <!--
            Actualizacion diaria de la TRM.

            La BCV publica la tasa una vez al dia. Se consulta a la 01:00 para
            tenerla disponible antes de que empiece la operacion del dia.

            Los fines de semana y los feriados (calendario o bancarios) la BCV no
            publica tasa: la consulta simple no escribe nada, y la resolucion de
            vigencia `name <= fecha` mantiene automaticamente la ultima tasa
            publicada. El metodo `recuperar_tasas_historicas()` cubre el relleno
            de dias sin publicacion.
        -->
        <record id="update_trm_res_currency" model="ir.cron">
            <field name="name">LocVe: Actualizar TRM BCV (diario 01:00)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="priority">2</field>
            <field name="state">code</field>
            <field name="model_id" ref="account_dual_currency.model_res_currency" />
            <field name="code">model._cron_actualizar_tasa()</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
