<odoo>
    <record id="res_config_settings_view_form_venrides" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.venrides</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="VenridesScreenS" data-key="venrides_screens" string="VenridesScreenS">
                    <h2>VenridesScreenS</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_api_public_url"/>
                                <field name="venrides_api_public_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_landing_url"/>
                                <field name="venrides_landing_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_admin_url"/>
                                <field name="venrides_admin_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_tv_url"/>
                                <field name="venrides_tv_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_odoo_url"/>
                                <field name="venrides_odoo_url"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_notification_email"/>
                                <field name="venrides_notification_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_support_email"/>
                                <field name="venrides_support_email"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="venrides_billing_email"/>
                                <field name="venrides_billing_email"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_venrides_settings" model="ir.actions.act_window">
        <field name="name">Configuración</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'venrides_screens'}</field>
    </record>
</odoo>
