<odoo>
    <record id="view_venrides_ticket_list" model="ir.ui.view">
        <field name="name">venrides.ticket.list</field>
        <field name="model">venrides.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="create_date"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="user_id"/>
                <field name="category"/>
                <field name="priority" widget="badge"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_venrides_ticket_form" model="ir.ui.view">
        <field name="name">venrides.ticket.form</field>
        <field name="model">venrides.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="open,in_progress,resolved,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Asunto"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="user_id"/>
                            <field name="category"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <field name="message_ids" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_venrides_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">venrides.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
