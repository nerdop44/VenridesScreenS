<odoo>
    <record id="view_venrides_company_list" model="ir.ui.view">
        <field name="name">venrides.company.list</field>
        <field name="model">venrides.company</field>
        <field name="arch" type="xml">
            <list string="Empresas">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="total_screens"/>
                <field name="active_screens"/>
                <field name="valid_until"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="view_venrides_company_kanban" model="ir.ui.view">
        <field name="name">venrides.company.kanban</field>
        <field name="model">venrides.company</field>
        <field name="arch" type="xml">
            <kanban default_group_by="plan_id" class="o_kanban_small">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="total_screens"/>
                <field name="is_active"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div><field name="plan_id"/></div>
                            <div>Pantallas: <field name="total_screens"/></div>
                            <div><field name="is_active" widget="boolean_toggle"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_venrides_company_form" model="ir.ui.view">
        <field name="name">venrides.company.form</field>
        <field name="model">venrides.company</field>
        <field name="arch" type="xml">
            <form string="Empresa">
                <header>
                    <button name="action_preview_tv" type="object" string="Previsualizar TV" class="oe_highlight"/>
                    <button name="action_generate_registration_code" type="object" string="Generar código"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-tv">
                            <field name="total_screens" widget="statinfo" string="Pantallas"/>
                        </button>
                        <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="active_screens" widget="statinfo" string="Activas"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <span class="o_stat_text">Pagos</span>
                        </button>
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <span class="o_stat_text">Tickets</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nombre comercial"/>
                        <h1><field name="name" placeholder="Nombre de la empresa"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="plan_id"/>
                            <field name="max_screens"/>
                            <field name="max_screens_effective"/>
                            <field name="is_active"/>
                            <field name="valid_until"/>
                            <field name="plan_activated_at"/>
                            <field name="first_screen_connected_at"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="whatsapp"/>
                            <field name="rif"/>
                            <field name="contact_person"/>
                            <field name="birthday"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Perfil de negocio">
                            <group>
                                <group>
                                    <field name="address"/>
                                    <field name="instagram"/>
                                    <field name="facebook"/>
                                    <field name="tiktok"/>
                                </group>
                                <group>
                                    <field name="can_edit_profile"/>
                                    <field name="has_edited_profile"/>
                                    <field name="client_editable_fields"/>
                                    <field name="is_email_verified"/>
                                    <field name="is_phone_verified"/>
                                </group>
                            </group>
                        </page>
                        <page string="Branding">
                            <group>
                                <group>
                                    <field name="layout_type"/>
                                    <field name="primary_color" widget="color"/>
                                    <field name="secondary_color" widget="color"/>
                                    <field name="accent_color" widget="color"/>
                                    <field name="logo" widget="image" options="{'size': [0, 120]}"/>
                                    <field name="logo_url"/>
                                </group>
                                <group>
                                    <field name="video_source"/>
                                    <field name="filler_keywords"/>
                                    <field name="google_drive_link"/>
                                    <field name="priority_content_url"/>
                                    <field name="pause_duration"/>
                                    <field name="ad_frequency"/>
                                    <field name="sidebar_header_type"/>
                                    <field name="sidebar_header_value"/>
                                </group>
                            </group>
                        </page>
                        <page string="Contenido">
                            <field name="video_playlist"/>
                            <field name="sidebar_content"/>
                            <field name="bottom_bar_content"/>
                            <field name="design_settings"/>
                        </page>
                        <page string="Notificaciones">
                            <field name="auto_notification_settings"/>
                            <field name="notes"/>
                        </page>
                        <page string="Historial">
                            <field name="message_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_venrides_company_search" model="ir.ui.view">
        <field name="name">venrides.company.search</field>
        <field name="model">venrides.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <filter name="active" string="Activas" domain="[('is_active','=',True)]"/>
                <filter name="inactive" string="Suspendidas" domain="[('is_active','=',False)]"/>
                <filter name="expired" string="Vencidas" domain="[('valid_until','&lt;', context_today().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_active" string="Estado" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_venrides_company" model="ir.actions.act_window">
        <field name="name">Empresas</field>
        <field name="res_model">venrides.company</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_venrides_company_search"/>
    </record>
</odoo>
