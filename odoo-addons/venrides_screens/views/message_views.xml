<odoo>
    <record id="view_venrides_message_list" model="ir.ui.view">
        <field name="name">venrides.message.list</field>
        <field name="model">venrides.message</field>
        <field name="arch" type="xml">
            <list string="Mensajes">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="sender_id"/>
                <field name="receiver_id"/>
                <field name="subject"/>
                <field name="is_alert"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>
    <record id="view_venrides_message_form" model="ir.ui.view">
        <field name="name">venrides.message.form</field>
        <field name="model">venrides.message</field>
        <field name="arch" type="xml">
            <form string="Mensaje">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="sender_id"/>
                            <field name="receiver_id"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="is_alert"/>
                            <field name="alert_duration"/>
                            <field name="is_read"/>
                            <field name="session_id"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <field name="attachment_url"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_venrides_message" model="ir.actions.act_window">
        <field name="name">Mensajes y alertas</field>
        <field name="res_model">venrides.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_venrides_chat_thread_list" model="ir.ui.view">
        <field name="name">venrides.chat.thread.list</field>
        <field name="model">venrides.chat.thread</field>
        <field name="arch" type="xml">
            <list string="Conversaciones">
                <field name="participant_1_id"/>
                <field name="participant_2_id"/>
                <field name="last_message_at"/>
                <field name="last_subject"/>
            </list>
        </field>
    </record>
    <record id="view_venrides_chat_thread_form" model="ir.ui.view">
        <field name="name">venrides.chat.thread.form</field>
        <field name="model">venrides.chat.thread</field>
        <field name="arch" type="xml">
            <form string="Conversación">
                <sheet>
                    <group>
                        <field name="participant_1_id"/>
                        <field name="participant_2_id"/>
                        <field name="last_message_at"/>
                        <field name="last_subject"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_venrides_chat_thread" model="ir.actions.act_window">
        <field name="name">Chat interno</field>
        <field name="res_model">venrides.chat.thread</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_venrides_blocked_user_list" model="ir.ui.view">
        <field name="name">venrides.blocked.user.list</field>
        <field name="model">venrides.blocked.user</field>
        <field name="arch" type="xml">
            <list string="Bloqueos">
                <field name="create_date"/>
                <field name="blocker_id"/>
                <field name="blocked_id"/>
                <field name="reason"/>
            </list>
        </field>
    </record>
    <record id="view_venrides_blocked_user_form" model="ir.ui.view">
        <field name="name">venrides.blocked.user.form</field>
        <field name="model">venrides.blocked.user</field>
        <field name="arch" type="xml">
            <form string="Bloqueo">
                <sheet>
                    <group>
                        <field name="blocker_id"/>
                        <field name="blocked_id"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_venrides_blocked_user" model="ir.actions.act_window">
        <field name="name">Usuarios bloqueados</field>
        <field name="res_model">venrides.blocked.user</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
