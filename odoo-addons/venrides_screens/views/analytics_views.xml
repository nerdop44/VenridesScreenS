<odoo>
    <record id="view_venrides_analytics_visit_list" model="ir.ui.view">
        <field name="name">venrides.analytics.visit.list</field>
        <field name="model">venrides.analytics.visit</field>
        <field name="arch" type="xml">
            <list string="Visitas">
                <field name="visit_date"/>
                <field name="page"/>
                <field name="referrer"/>
                <field name="device"/>
                <field name="ip_hash"/>
            </list>
        </field>
    </record>
    <record id="view_venrides_analytics_visit_pivot" model="ir.ui.view">
        <field name="name">venrides.analytics.visit.pivot</field>
        <field name="model">venrides.analytics.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visitas">
                <field name="visit_date" interval="day" type="row"/>
                <field name="device" type="col"/>
                <field name="id" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_venrides_analytics_visit_graph" model="ir.ui.view">
        <field name="name">venrides.analytics.visit.graph</field>
        <field name="model">venrides.analytics.visit</field>
        <field name="arch" type="xml">
            <graph string="Visitas" type="line">
                <field name="visit_date" interval="day"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_venrides_analytics_visit" model="ir.actions.act_window">
        <field name="name">Analítica web</field>
        <field name="res_model">venrides.analytics.visit</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
</odoo>
