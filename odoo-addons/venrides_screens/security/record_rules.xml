<odoo>
    <!-- Empresas -->
    <record id="rule_company_admin" model="ir.rule">
        <field name="name">Venrides: empresa propia (admin)</field>
        <field name="model_id" ref="model_venrides_company"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin'))]"/>
        <field name="domain_force">[('id', '=', user.venrides_company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_company_read" model="ir.rule">
        <field name="name">Venrides: empresa propia (lectura)</field>
        <field name="model_id" ref="model_venrides_company"/>
        <field name="groups" eval="[(4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">[('id', '=', user.venrides_company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Dispositivos -->
    <record id="rule_device_admin" model="ir.rule">
        <field name="name">Venrides: dispositivos de la empresa (admin)</field>
        <field name="model_id" ref="model_venrides_device"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
    </record>
    <record id="rule_device_read" model="ir.rule">
        <field name="name">Venrides: dispositivos de la empresa (lectura)</field>
        <field name="model_id" ref="model_venrides_device"/>
        <field name="groups" eval="[(4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Pagos -->
    <record id="rule_payment_admin" model="ir.rule">
        <field name="name">Venrides: pagos de la empresa</field>
        <field name="model_id" ref="model_venrides_payment"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Menús -->
    <record id="rule_menu_admin" model="ir.rule">
        <field name="name">Venrides: menú de la empresa (admin)</field>
        <field name="model_id" ref="model_venrides_menu_item"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
    </record>
    <record id="rule_menu_read" model="ir.rule">
        <field name="name">Venrides: menú de la empresa (lectura)</field>
        <field name="model_id" ref="model_venrides_menu_item"/>
        <field name="groups" eval="[(4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Códigos y usos de plan -->
    <record id="rule_registration_admin" model="ir.rule">
        <field name="name">Venrides: códigos de la empresa</field>
        <field name="model_id" ref="model_venrides_registration_code"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
    </record>
    <record id="rule_free_usage_admin" model="ir.rule">
        <field name="name">Venrides: usos free de la empresa</field>
        <field name="model_id" ref="model_venrides_free_plan_usage"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin'))]"/>
        <field name="domain_force">[('company_id', '=', user.venrides_company_id.id)]</field>
    </record>

    <!-- Mensajes -->
    <record id="rule_message_client" model="ir.rule">
        <field name="name">Venrides: mensajes propios o de la empresa</field>
        <field name="model_id" ref="model_venrides_message"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">['|', '|', ('company_id', '=', user.venrides_company_id.id), ('sender_id', '=', user.id), ('receiver_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Chat -->
    <record id="rule_chat_participant" model="ir.rule">
        <field name="name">Venrides: conversaciones propias</field>
        <field name="model_id" ref="model_venrides_chat_thread"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">['|', ('participant_1_id', '=', user.id), ('participant_2_id', '=', user.id)]</field>
    </record>
    <record id="rule_blocked_own" model="ir.rule">
        <field name="name">Venrides: bloqueos propios</field>
        <field name="model_id" ref="model_venrides_blocked_user"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">[('blocker_id', '=', user.id)]</field>
    </record>

    <!-- Tickets -->
    <record id="rule_ticket_client" model="ir.rule">
        <field name="name">Venrides: tickets propios o de la empresa</field>
        <field name="model_id" ref="model_venrides_ticket"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('company_id', '=', user.venrides_company_id.id)]</field>
    </record>
    <record id="rule_ticket_message_client" model="ir.rule">
        <field name="name">Venrides: mensajes de tickets propios</field>
        <field name="model_id" ref="model_venrides_ticket_message"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">['|', ('ticket_id.user_id', '=', user.id), ('ticket_id.company_id', '=', user.venrides_company_id.id)]</field>
    </record>

    <!-- Tokens -->
    <record id="rule_api_token_own" model="ir.rule">
        <field name="name">Venrides: tokens propios</field>
        <field name="model_id" ref="model_venrides_api_token"/>
        <field name="groups" eval="[(4, ref('group_venrides_company_admin')), (4, ref('group_venrides_operator')), (4, ref('group_venrides_basic'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
