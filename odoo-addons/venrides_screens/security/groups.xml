<odoo>
    <record id="module_category_venrides" model="ir.module.category">
        <field name="name">VenridesScreenS</field>
        <field name="description">Acceso a la plataforma de señalización digital</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_venrides_master" model="res.groups">
        <field name="name">Maestro</field>
        <field name="category_id" ref="module_category_venrides"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_venrides_company_admin" model="res.groups">
        <field name="name">Administrador de empresa</field>
        <field name="category_id" ref="module_category_venrides"/>
    </record>

    <record id="group_venrides_operator" model="res.groups">
        <field name="name">Operador de empresa</field>
        <field name="category_id" ref="module_category_venrides"/>
    </record>

    <record id="group_venrides_basic" model="res.groups">
        <field name="name">Usuario básico</field>
        <field name="category_id" ref="module_category_venrides"/>
    </record>
</odoo>
