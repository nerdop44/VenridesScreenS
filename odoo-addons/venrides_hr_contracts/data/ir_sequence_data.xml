<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_contract" model="ir.sequence">
            <field name="name">Contrato de trabajo</field>
            <field name="code">venrides.contract</field>
            <field name="prefix">CT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_contract_status" model="ir.cron">
            <field name="name">Contratos: por vencer y vencidos</field>
            <field name="model_id" ref="venrides_payroll.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_contract_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
