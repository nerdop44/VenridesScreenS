<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div t-out="o.rendered_body"/>

                        <t t-foreach="o.template_id.clause_ids" t-as="clause">
                            <t t-if="clause.clause_type == 'general' or (clause.clause_type == 'specific' and o.job_id in clause.job_ids)">
                                <div class="mt-3" t-out="o.template_id._render_text(clause.body, o)"/>
                            </t>
                        </t>

                        <div class="mt-4">
                            <h4>ANEXOS</h4>
                            <p class="small text-muted">
                                Los siguientes anexos forman parte integrante del contrato.
                            </p>
                            <t t-foreach="o.annex_ids" t-as="annex">
                                <div class="mt-3" t-out="o.template_id._render_text(annex.body, o)"/>
                            </t>
                            <t t-if="not o.annex_ids">
                                <p class="text-muted">Sin anexos registrados.</p>
                            </t>
                        </div>

                        <div class="mt-4" t-if="o.salary_table_line_id">
                            <h4>DETALLE DE LA TABLA SALARIAL</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Concepto</th>
                                        <th class="text-end">Monto mensual (USD)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Salario base</td>
                                        <td class="text-end" t-out="'%.2f' % o.salary_table_line_id.base_usd"/>
                                    </tr>
                                    <tr>
                                        <td>Bono de guerra</td>
                                        <td class="text-end" t-out="'%.2f' % o.salary_table_line_id.bono_guerra_usd"/>
                                    </tr>
                                    <tr>
                                        <td>Bono de transporte y asistencia</td>
                                        <td class="text-end" t-out="'%.2f' % o.salary_table_line_id.bono_transporte_usd"/>
                                    </tr>
                                    <tr>
                                        <td>Bono de desempeño (máximo)</td>
                                        <td class="text-end" t-out="'%.2f' % o.salary_table_line_id.bono_desempeno_max_usd"/>
                                    </tr>
                                    <tr>
                                        <td>Cestatickets</td>
                                        <td class="text-end" t-out="'%.2f' % o.salary_table_line_id.cestaticket_usd"/>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td>Total referencial</td>
                                        <td class="text-end" t-out="'%.2f' % o.salary_table_line_id.total_usd"/>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="small text-muted">
                                El bono de desempeño es variable y puede disminuir según el
                                cumplimiento de las metas globales, individuales y del puesto.
                            </p>
                        </div>

                        <div class="mt-5">
                            <h4>FIRMAS</h4>
                            <div class="row mt-4">
                                <div class="col-6 text-center">
                                    <div style="border-top:1px solid #333;padding-top:6px;">
                                        <strong t-out="o.company_id.name or ''"/>
                                        <br/>LA EMPRESA
                                    </div>
                                </div>
                                <div class="col-6 text-center">
                                    <t t-if="o.signature_image_data">
                                        <img t-att-src="o.signature_image_data"
                                             style="max-height:90px;max-width:220px;"/>
                                    </t>
                                    <div style="border-top:1px solid #333;padding-top:6px;">
                                        <strong t-out="o.employee_id.name or ''"/>
                                        <br/>EL TRABAJADOR
                                    </div>
                                </div>
                            </div>
                            <p class="small text-muted mt-4" t-if="o.signature_state == 'signed'">
                                Firmado digitalmente el
                                <span t-out="o.signed_date or ''"/>.
                                Hash SHA-256:
                                <span t-out="o.document_hash or ''"/>
                            </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
