<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_annex_list" model="ir.ui.view">
        <field name="name">venrides.contract.annex.list</field>
        <field name="model">venrides.contract.annex</field>
        <field name="arch" type="xml">
            <list string="Anexos">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="annex_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_annex_form" model="ir.ui.view">
        <field name="name">venrides.contract.annex.form</field>
        <field name="model">venrides.contract.annex</field>
        <field name="arch" type="xml">
            <form string="Anexo">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="annex_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_contract_annex" model="ir.actions.act_window">
        <field name="name">Anexos</field>
        <field name="res_model">venrides.contract.annex</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
