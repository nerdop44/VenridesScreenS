<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_template_list" model="ir.ui.view">
        <field name="name">venrides.contract.template.list</field>
        <field name="model">venrides.contract.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de contrato">
                <field name="code"/>
                <field name="name"/>
                <field name="version"/>
                <field name="contract_type_id"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="contract_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_contract_template_form" model="ir.ui.view">
        <field name="name">venrides.contract.template.form</field>
        <field name="model">venrides.contract.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de contrato">
                <header>
                    <button name="action_new_version" type="object"
                            string="Crear nueva versión" class="btn-primary"/>
                    <button name="action_view_contracts" type="object"
                            string="Contratos" invisible="not contract_count"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h3>
                            <field name="code" class="oe_inline"/> ·
                            v<field name="version" class="oe_inline"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="contract_type_id"/>
                            <field name="salary_table_id"/>
                            <field name="is_current"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                            <field name="root_id"/>
                            <field name="contract_count"/>
                        </group>
                    </group>
                    <field name="job_ids" widget="many2many_tags"/>
                    <notebook>
                        <page string="Cuerpo del contrato" name="body">
                            <field name="body_html"/>
                        </page>
                        <page string="Cláusulas" name="clauses">
                            <field name="clause_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="clause_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Anexos" name="annexes">
                            <field name="annex_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="annex_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_contract_template" model="ir.actions.act_window">
        <field name="name">Plantillas de contrato</field>
        <field name="res_model">venrides.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
