<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_signature_list" model="ir.ui.view">
        <field name="name">venrides.contract.signature.list</field>
        <field name="model">venrides.contract.signature</field>
        <field name="arch" type="xml">
            <list string="Firmas">
                <field name="contract_id"/>
                <field name="signer_name"/>
                <field name="signer_email"/>
                <field name="method"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'signed'"/>
                <field name="verified_at"/>
                <field name="ip_address"/>
            </list>
        </field>
    </record>

    <record id="view_signature_form" model="ir.ui.view">
        <field name="name">venrides.contract.signature.form</field>
        <field name="model">venrides.contract.signature</field>
        <field name="arch" type="xml">
            <form string="Firma" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="signer_name"/>
                            <field name="signer_email"/>
                            <field name="method"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="sent_at"/>
                            <field name="verified_at"/>
                            <field name="ip_address"/>
                            <field name="user_agent"/>
                            <field name="document_hash"/>
                        </group>
                    </group>
                    <field name="image" widget="image"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_contract_signature" model="ir.actions.act_window">
        <field name="name">Firmas de contratos</field>
        <field name="res_model">venrides.contract.signature</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
