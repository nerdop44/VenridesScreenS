<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clause_list" model="ir.ui.view">
        <field name="name">venrides.contract.clause.list</field>
        <field name="model">venrides.contract.clause</field>
        <field name="arch" type="xml">
            <list string="Cláusulas">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="clause_type"/>
                <field name="job_ids" widget="many2many_tags"/>
                <field name="mandatory"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_clause_form" model="ir.ui.view">
        <field name="name">venrides.contract.clause.form</field>
        <field name="model">venrides.contract.clause</field>
        <field name="arch" type="xml">
            <form string="Cláusula">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="clause_type"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="job_ids" widget="many2many_tags"
                                   invisible="clause_type != 'specific'"/>
                            <field name="mandatory"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_contract_clause" model="ir.actions.act_window">
        <field name="name">Cláusulas</field>
        <field name="res_model">venrides.contract.clause</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
