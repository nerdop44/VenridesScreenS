<odoo>
    <data noupdate="1">
        <record id="ir_cron_vscreens_bcv" model="ir.cron">
            <field name="name">VScreenS: actualizar tasa BCV</field>
            <field name="model_id" ref="model_vscreens_currency"/>
            <field name="state">code</field>
            <field name="code">model.cron_refresh_bcv()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_vscreens_crm_followup" model="ir.cron">
            <field name="name">VScreenS: seguimiento automático de leads</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_crm_followup()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_vscreens_odoo_link" model="ir.cron">
            <field name="name">VScreenS: sincronizar enlaces Odoo de clientes</field>
            <field name="model_id" ref="model_vscreens_company"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_odoo_links()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_vscreens_cleanup_request_log" model="ir.cron">
            <field name="name">VScreenS: limpiar registro de peticiones</field>
            <field name="model_id" ref="model_vscreens_request_log"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_old()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
