<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================================
         CRM VSCREENS - Vistas para leads de VScreenS (campos personalizados)
         ============================================================================ -->

    <record id="view_vscreens_crm_lead_search" model="ir.ui.view">
        <field name="name">vscreens.crm.lead.search</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="vscreens_source_detail"/>
                <field name="vscreens_plan_interest"/>
                <field name="vscreens_contact_name"/>
                <filter name="vscreens_leads" string="Leads VScreenS" domain="[('vscreens_source_detail', '!=', False)]"/>
                <filter name="open" string="Abiertos" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="view_vscreens_crm_lead_tree" model="ir.ui.view">
        <field name="name">vscreens.crm.lead.tree</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <list string="Leads VScreenS">
                <field name="name"/>
                <field name="contact_name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="vscreens_source_detail"/>
                <field name="vscreens_plan_interest"/>
                <field name="vscreens_contact_name"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_vscreens_crm_lead_form" model="ir.ui.view">
        <field name="name">vscreens.crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="arch" type="xml">
            <form string="Lead VScreenS">
                <header>
                    <button name="action_send_followup" type="object" string="Enviar seguimiento ahora" class="oe_highlight"/>
                    <button name="action_send_test_email" type="object" string="Enviar correo de prueba"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Información del Lead">
                        <group>
                            <field name="contact_name"/>
                            <field name="email_from"/>
                            <field name="phone"/>
                            <field name="vscreens_contact_name"/>
                        </group>
                        <group>
                            <field name="vscreens_source_detail"/>
                            <field name="vscreens_plan_interest"/>
                            <field name="type"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Seguimiento automático">
                        <group>
                            <field name="vscreens_followup_active"/>
                            <field name="vscreens_followup_count"/>
                            <field name="vscreens_last_followup"/>
                        </group>
                        <group>
                            <field name="vscreens_next_followup"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vscreens_crm_leads" model="ir.actions.act_window">
        <field name="name">Leads VScreenS</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('vscreens_source_detail', '!=', False)]</field>
        <field name="search_view_id" ref="view_vscreens_crm_lead_search"/>
        <field name="context">{'default_type': 'lead', 'default_vscreens_source_detail': 'VScreenS Panel'}</field>
    </record>
    <record id="action_vscreens_crm_mass_followup" model="ir.actions.server">
        <field name="name">Enviar seguimiento a los seleccionados</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="binding_model_id" ref="crm.model_crm_lead"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_send_mass_followup()</field>
    </record>
</odoo>
