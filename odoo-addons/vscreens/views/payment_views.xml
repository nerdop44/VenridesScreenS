<odoo>
    <record id="view_vscreens_payment_list" model="ir.ui.view">
        <field name="name">vscreens.payment.list</field>
        <field name="model">vscreens.payment</field>
        <field name="arch" type="xml">
            <list string="Pagos">
                <field name="payment_date"/>
                <field name="company_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id"/>
                <field name="payment_method"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_vscreens_payment_form" model="ir.ui.view">
        <field name="name">vscreens.payment.form</field>
        <field name="model">vscreens.payment</field>
        <field name="arch" type="xml">
            <form string="Pago">
                <header>
                    <button name="action_create_invoice" type="object" string="Crear factura" class="oe_highlight" invisible="account_move_id"/>
                    <button name="action_view_invoice" type="object" string="Ver factura" invisible="not account_move_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="state"/>
                            <field name="reference"/>
                            <field name="description"/>
                            <field name="account_move_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_vscreens_payment_search" model="ir.ui.view">
        <field name="name">vscreens.payment.search</field>
        <field name="model">vscreens.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id"/>
                <field name="payment_date"/>
                <filter name="confirmed" string="Confirmados" domain="[('state','=','confirmed')]"/>
                <group>
                    <filter name="group_company" string="Empresa" context="{'group_by': 'company_id'}"/>
                    <filter name="group_month" string="Mes" context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_vscreens_payment" model="ir.actions.act_window">
        <field name="name">Pagos</field>
        <field name="res_model">vscreens.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_vscreens_payment_search"/>
    </record>
</odoo>
