<odoo>
    <record id="view_vscreens_plan_list" model="ir.ui.view">
        <field name="name">vscreens.plan.list</field>
        <field name="model">vscreens.plan</field>
        <field name="arch" type="xml">
            <list string="Planes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="max_screens"/>
                <field name="monthly_price"/>
                <field name="annual_price"/>
                <field name="is_public"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_vscreens_plan_form" model="ir.ui.view">
        <field name="name">vscreens.plan.form</field>
        <field name="model">vscreens.plan</field>
        <field name="arch" type="xml">
            <form string="Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre del plan"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="subtitle"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="is_public"/>
                            <field name="popular"/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="max_screens" help="0 = ilimitadas"/>
                            <field name="max_users" help="0 = ilimitados"/>
                            <field name="trial_days"/>
                            <field name="is_custom"/>
                            <field name="monthly_price"/>
                            <field name="annual_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Características">
                            <field name="feature_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Permisos del plan">
                            <group>
                                <group>
                                    <field name="allow_third_party_ads"/>
                                    <field name="allow_custom_branding"/>
                                    <field name="allow_sidebar"/>
                                    <field name="allow_bottom_bar"/>
                                    <field name="allow_video_playlist"/>
                                    <field name="allow_priority_content"/>
                                </group>
                                <group>
                                    <field name="allow_bcv"/>
                                    <field name="allow_multi_user"/>
                                    <field name="allow_helpdesk"/>
                                    <field name="allow_mobile"/>
                                    <field name="allow_api"/>
                                </group>
                            </group>
                        </page>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vscreens_plan" model="ir.actions.act_window">
        <field name="name">Planes</field>
        <field name="res_model">vscreens.plan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
