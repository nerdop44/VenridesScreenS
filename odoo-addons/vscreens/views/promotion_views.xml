<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Promotions -->
    <record id="view_vscreens_promotion_tree" model="ir.ui.view">
        <field name="name">vscreens.promotion.tree</field>
        <field name="model">vscreens.promotion</field>
        <field name="arch" type="xml">
            <list string="Promociones">
                <field name="name"/>
                <field name="code"/>
                <field name="discount_pct"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_vscreens_promotion_form" model="ir.ui.view">
        <field name="name">vscreens.promotion.form</field>
        <field name="model">vscreens.promotion</field>
        <field name="arch" type="xml">
            <form string="Promoción">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Promoción">
                        <group>
                            <field name="code"/>
                            <field name="discount_pct"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vscreens_promotion" model="ir.actions.act_window">
        <field name="name">Promociones</field>
        <field name="res_model">vscreens.promotion</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_vscreens_promotion"
              name="Promociones"
              parent="vscreens.menu_crm"
              action="action_vscreens_promotion"
              sequence="20"/>
</odoo>
