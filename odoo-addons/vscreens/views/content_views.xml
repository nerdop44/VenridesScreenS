<odoo>
    <!-- Publicidad global -->
    <record id="view_vscreens_global_ad_list" model="ir.ui.view">
        <field name="name">vscreens.global.ad.list</field>
        <field name="model">vscreens.global.ad</field>
        <field name="arch" type="xml">
            <list string="Publicidad global">
                <field name="name"/>
                <field name="active"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>
    <record id="view_vscreens_global_ad_form" model="ir.ui.view">
        <field name="name">vscreens.global.ad.form</field>
        <field name="model">vscreens.global.ad</field>
        <field name="arch" type="xml">
            <form string="Publicidad global">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="video_url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Playlist"><field name="video_playlist"/></page>
                        <page string="Ticker">
                            <field name="ticker_text"/>
                            <field name="ticker_messages"/>
                        </page>
                        <page string="Scripts"><field name="ad_scripts"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vscreens_global_ad" model="ir.actions.act_window">
        <field name="name">Publicidad global</field>
        <field name="res_model">vscreens.global.ad</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú del cliente -->
    <record id="view_vscreens_menu_item_list" model="ir.ui.view">
        <field name="name">vscreens.menu.item.list</field>
        <field name="model">vscreens.menu.item</field>
        <field name="arch" type="xml">
            <list string="Menú">
                <field name="company_id"/>
                <field name="category"/>
                <field name="name"/>
                <field name="price"/>
                <field name="is_available"/>
            </list>
        </field>
    </record>
    <record id="view_vscreens_menu_item_form" model="ir.ui.view">
        <field name="name">vscreens.menu.item.form</field>
        <field name="model">vscreens.menu.item</field>
        <field name="arch" type="xml">
            <form string="Ítem de menú">
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="price"/>
                        <field name="is_available"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vscreens_menu_item" model="ir.actions.act_window">
        <field name="name">Menús de clientes</field>
        <field name="res_model">vscreens.menu.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Plantillas de email -->
    <record id="view_vscreens_email_template_list" model="ir.ui.view">
        <field name="name">vscreens.email.template.list</field>
        <field name="model">vscreens.email.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas">
                <field name="name"/>
                <field name="category"/>
                <field name="subject"/>
                <field name="is_system"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_vscreens_email_template_form" model="ir.ui.view">
        <field name="name">vscreens.email.template.form</field>
        <field name="model">vscreens.email.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="is_system"/>
                        <field name="active"/>
                        <field name="subject"/>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_vscreens_email_template" model="ir.actions.act_window">
        <field name="name">Plantillas de email</field>
        <field name="res_model">vscreens.email.template</field>
        <field name="view_mode">list,form</field>
