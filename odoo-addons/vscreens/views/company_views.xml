<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================================
         LISTA DE EMPRESAS
         ============================================================================ -->
    <record id="view_vscreens_company_list" model="ir.ui.view">
        <field name="name">vscreens.company.list</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <list string="Empresas Registradas" decoration-danger="not is_active">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="total_screens" string="Pantallas"/>
                <field name="online_screens" string="Transmitiendo"/>
                <field name="offline_screens" string="Sin señal"/>
                <field name="valid_until"/>
                <field name="is_active" widget="boolean_toggle" string="Activa"/>
            </list>
        </field>
    </record>

    <!-- ============================================================================
         KANBAN: estado real de las pantallas por empresa
         ============================================================================ -->
    <record id="view_vscreens_company_kanban" model="ir.ui.view">
        <field name="name">vscreens.company.kanban</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <kanban default_group_by="plan_id" class="o_kanban_mobile">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="total_screens"/>
                <field name="active_screens"/>
                <field name="online_screens"/>
                <field name="offline_screens"/>
                <field name="is_active"/>
                <field name="valid_until"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <span t-if="record.is_active.value" class="vs_kanban_badge_on">ACTIVA</span>
                                <span t-if="!record.is_active.value" class="vs_kanban_badge_off">SUSPENDIDA</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.78rem; margin-top: 2px;">
                                <field name="plan_id"/>
                            </div>
                            <div class="vs_kanban_screens">
                                <span class="vs_on">● <field name="online_screens"/> transmitiendo</span>
                                <span class="vs_off">● <field name="offline_screens"/> sin señal</span>
                            </div>
                            <div class="text-muted" style="font-size: 0.72rem;">
                                <field name="active_screens"/>/<field name="total_screens"/> pantallas habilitadas
                            </div>
                            <div class="text-muted" style="font-size: 0.72rem;" t-if="record.valid_until.value">
                                Vence: <field name="valid_until"/>
                            </div>
                            <div class="oe_kanban_bottom_right mt-2">
                                <button name="action_view_devices" type="object"
                                        class="btn btn-sm btn-link" string="Ver pantallas"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================================
         FORMULARIO DE EMPRESA
         - Panel de vista previa en vivo, arriba a la derecha sobre las pestañas.
         - Sin JSON ni código expuesto: todos los ajustes son controles visuales.
         ============================================================================ -->
    <record id="view_vscreens_company_form" model="ir.ui.view">
        <field name="name">vscreens.company.form</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <form string="Empresa">
                <header>
                    <button name="action_push_config" type="object"
                            string="📡 Enviar a Pantallas" class="oe_highlight"
                            help="Publica la configuración actual en todas las pantallas o en las seleccionadas."/>
                    <button name="action_generate_registration_code" type="object"
                            string="🔗 Código de Vinculación"/>
                    <button name="action_view_devices" type="object"
                            string="🖥 Gestionar Pantallas"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-tv">
                            <field name="total_screens" widget="statinfo" string="Pantallas"/>
                        </button>
                        <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-signal">
                            <field name="online_screens" widget="statinfo" string="Transmitiendo"/>
                        </button>
                        <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="active_screens" widget="statinfo" string="Habilitadas"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <span class="o_stat_text">Pagos</span>
                        </button>
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <span class="o_stat_text">Tickets</span>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="is_active">
                        <strong>Servicio suspendido.</strong>
                        Las pantallas de esta empresa no están mostrando contenido.
                        Activa la empresa en «Información de la Empresa» para reanudar el servicio.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nombre Comercial"/>
                        <h1><field name="name" placeholder="Nombre de la empresa"/></h1>
                    </div>

                    <!-- Vista previa en vivo: flota arriba a la derecha, sobre las pestañas -->
                    <div class="vs_tv_preview_anchor">
                        <field name="config_version" widget="vscreens_tv_preview"/>
                    </div>

                    <group string="Información de la Empresa" col="4">
                        <field name="partner_id"/>
                        <field name="plan_id"/>
                        <field name="rif"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="whatsapp"/>
                        <field name="valid_until"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </group>

                    <notebook>
                        <page string="📋 Perfil de Negocio" name="profile">
                            <group col="4">
                                <field name="address"/>
                                <field name="instagram"/>
                                <field name="facebook"/>
                                <field name="tiktok"/>
                                <field name="contact_person"/>
                                <field name="birthday"/>
                            </group>
                        </page>

                        <page string="🎨 Diseño y Branding" name="branding">
                            <group col="4">
                                <field name="layout_type"/>
                                <field name="primary_color" widget="color"/>
                                <field name="secondary_color" widget="color"/>
                                <field name="accent_color" widget="color"/>
                                <field name="logo" widget="image" options="{'size': [0, 120]}"/>
                                <field name="logo_url"/>
                            </group>
                            <group string="Encabezado de la barra lateral" col="4">
                                <field name="sidebar_header_type"/>
                                <field name="sidebar_header_value"/>
                            </group>
                        </page>

                        <page string="📺 Contenido TV" name="content">
                            <group col="4">
                                <field name="video_source"/>
                                <field name="filler_keywords"/>
                                <field name="google_drive_link"/>
                                <field name="priority_content_url"/>
                                <field name="pause_duration"/>
                                <field name="ad_frequency"/>
                            </group>
                        </page>

                        <page string="🎵 Playlist de Videos" name="playlist">
                            <field name="playlist_items">
                                <list editable="bottom" string="Playlist">
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="url" widget="url" placeholder="https://www.youtube.com/watch?v=..."/>
                                    <field name="youtube_id" readonly="1" optional="hide"/>
                                    <field name="is_active" string="Activo"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                                Los videos se reproducen en secuencia en la TV. Pega la URL completa de YouTube.
                            </p>
                        </page>

                        <page string="📅 Videos Programados" name="scheduled">
                            <field name="scheduled_video_items">
                                <list editable="bottom" string="Videos programados">
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="url" widget="url" placeholder="https://www.youtube.com/watch?v=..."/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="duration"/>
                                    <field name="is_active" string="Activo"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                                Tienen prioridad sobre la playlist durante su ventana de fecha y hora.
                            </p>
                        </page>

                        <page string="📊 Barra Lateral" name="sidebar">
                            <field name="sidebar_items">
                                <list editable="bottom" string="Ítems de barra lateral">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="value"/>
                                    <field name="icon"/>
                                    <field name="color" widget="color"/>
                                    <field name="is_active" string="Activo"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                                Rotan automáticamente según la pausa configurada. El valor es el texto que se muestra en la TV.
                            </p>
                        </page>

                        <page string="🔻 Barra Inferior" name="bottom_bar">
                            <field name="bottom_bar_items">
                                <list editable="bottom" string="Mensajes del ticker">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="value"/>
                                    <field name="color" widget="color"/>
                                    <field name="is_active" string="Activo"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                                Cada ítem es un mensaje del ticker inferior. El orden se puede arrastrar.
                            </p>
                        </page>

                        <page string="⚙️ Ajustes de Diseño" name="design">
                            <field name="design_settings_id">
                                <list string="Ajustes de diseño" editable="bottom">
                                    <field name="title_font"/>
                                    <field name="title_color" widget="color"/>
                                    <field name="title_size"/>
                                    <field name="sidebar_width"/>
                                    <field name="sidebar_bg" widget="color"/>
                                    <field name="sidebar_text" widget="color"/>
                                    <field name="bottom_bar_bg" widget="color"/>
                                    <field name="show_bcv" string="BCV"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                                Fuentes, colores, efectos y tasa BCV de la pantalla. Se aplica a todas las pantallas de la empresa.
                            </p>
                        </page>

                        <page string="🖥 Pantallas" name="devices">
                            <field name="device_ids" readonly="1">
                                <list string="Pantallas" create="0" delete="0">
                                    <field name="name"/>
                                    <field name="uuid" optional="hide"/>
                                    <field name="is_online" string="Transmitiendo"/>
                                    <field name="is_effective" string="Operativa"/>
                                    <field name="is_active" string="Habilitada" widget="boolean_toggle"/>
                                    <field name="last_ping" string="Última conexión"/>
                                    <field name="last_ip" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2 mb-0" style="font-size: 0.8rem;">
                                «Transmitiendo»: la pantalla se conectó en los últimos 5 minutos.
                                «Operativa»: la pantalla está habilitada y la empresa tiene el servicio activo y vigente.
                                Usa el panel de vista previa para enviar cambios a todas o sólo a algunas pantallas.
                            </p>
                        </page>

                        <page string="📧 Notificaciones" name="notifications">
                            <group string="Avisos automáticos" col="2">
                                <group>
                                    <field name="notification_welcome" widget="boolean_toggle"/>
                                    <field name="notification_billing" widget="boolean_toggle"/>
                                    <field name="notification_expiry_reminders" widget="boolean_toggle"/>
                                </group>
                                <group>
                                    <field name="notification_birthday_greetings" widget="boolean_toggle"/>
                                    <field name="notification_holiday_greetings" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <separator string="Notas internas"/>
                            <field name="notes" placeholder="Notas visibles sólo para el equipo de VScreenS"/>
                        </page>

                        <page string="📜 Historial" name="history">
                            <field name="message_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================================
         BÚSQUEDA
         ============================================================================ -->
    <record id="view_vscreens_company_search" model="ir.ui.view">
        <field name="name">vscreens.company.search</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="rif"/>
                <filter name="active" string="Activas" domain="[('is_active','=',True)]"/>
                <filter name="inactive" string="Suspendidas" domain="[('is_active','=',False)]"/>
                <group>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_active" string="Estado" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vscreens_company" model="ir.actions.act_window">
        <field name="name">Empresas</field>
        <field name="res_model">vscreens.company</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_vscreens_company_search"/>
    </record>
</odoo>
