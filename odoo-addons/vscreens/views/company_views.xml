<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Lista visual de empresas -->
    <record id="view_vscreens_company_list" model="ir.ui.view">
        <field name="name">vscreens.company.list</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <list string="Empresas Registradas">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="total_screens"/>
                <field name="active_screens"/>
                <field name="valid_until"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Kanban visual y atractivo -->
    <record id="view_vscreens_company_kanban" model="ir.ui.view">
        <field name="name">vscreens.company.kanban</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <kanban default_group_by="plan_id">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="total_screens"/>
                <field name="active_screens"/>
                <field name="is_active"/>
                <field name="valid_until"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_card_content">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="o_kanban_card_subtitle">
                                    <span class="badge"><field name="plan_id"/></span>
                                    <span t-if="is_active" class="badge-status">ACTIVA</span>
                                    <span t-if="not is_active" class="badge-status suspended">SUSPENDIDA</span>
                                </div>
                                <div class="o_kanban_card_stats">
                                    <span>Pantallas: <field name="active_screens"/>/<field name="total_screens"/></span>
                                    <span t-if="valid_until" class="valid-until">Vence: <field name="valid_until"/></span>
                                </div>
                            </div>
                            <div class="oe_kanban_footer">
                                <button name="action_preview_tv" type="object" class="oe_kanban_button_small" string="TV"/>
                                <button name="action_view_devices" type="object" class="oe_kanban_button_small" string="Pantallas"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Formulario visual y atractivo - SIN código expuesto -->
    <record id="view_vscreens_company_form" model="ir.ui.view">
        <field name="name">vscreens.company.form</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <form string="Empresa">
                <header>
                    <button name="action_preview_tv" type="object" string="📺 Previsualizar TV" class="oe_highlight"/>
                    <button name="action_generate_registration_code" type="object" string="🔗 Generar Código de Vinculación"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_devices" type="object" class="oe_stat_button" icon="fa-tv">
                            <field name="total_screens" widget="statinfo" string="Pantallas Totales"/>
                        </button>
                        <button name="action_view_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="active_screens" widget="statinfo" string="Pantallas Activas"/>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <span class="o_stat_text">Pagos</span>
                        </button>
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <span class="o_stat_text">Tickets</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nombre Comercial"/>
                        <h1><field name="name" placeholder="Nombre de la empresa"/></h1>
                    </div>
                    <group string="Información de la Empresa" col="4">
                        <field name="partner_id"/>
                        <field name="plan_id"/>
                        <field name="rif"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="whatsapp"/>
                        <field name="is_active" widget="boolean_toggle"/>
                        <field name="valid_until"/>
                    </group>
                    <notebook>
                        <page string="📋 Perfil de Negocio">
                            <group col="4">
                                <field name="address"/>
                                <field name="instagram"/>
                                <field name="facebook"/>
                                <field name="tiktok"/>
                                <field name="contact_person"/>
                            </group>
                        </page>
                        <page string="🎨 Diseño y Branding">
                            <group col="4">
                                <field name="layout_type"/>
                                <field name="primary_color" widget="color"/>
                                <field name="secondary_color" widget="color"/>
                                <field name="accent_color" widget="color"/>
                                <field name="logo" widget="image" options="{'size': [0, 120]}"/>
                                <field name="logo_url"/>
                            </group>
                        </page>
                        <page string="📺 Contenido TV">
                            <group col="4">
                                <field name="video_source"/>
                                <field name="filler_keywords"/>
                                <field name="google_drive_link"/>
                                <field name="priority_content_url"/>
                                <field name="pause_duration"/>
                                <field name="ad_frequency"/>
                            </group>
                        </page>
                        <page string="🎵 Playlist de Videos">
                            <group col="1">
                                <field name="playlist_items" widget="one2many_list" options="{'open': true}"/>
                                <p class="oe_form_helper_text" style="font-size: 12px; opacity: 0.7;">
                                    Agrega videos de YouTube a la playlist. Cada video se reproduce en secuencia en la TV.
                                </p>
                            </group>
                        </page>
                        <page string="📅 Videos Programados">
                            <group col="1">
                                <field name="scheduled_video_items" widget="one2many_list" options="{'open': true}"/>
                                <p class="oe_form_helper_text" style="font-size: 12px; opacity: 0.7;">
                                    Programa videos para reproducirse en fechas y horas específicas. Tienen prioridad sobre la playlist normal.
                                </p>
                            </group>
                        </page>
                        <page string="📊 Barra Lateral">
                            <group col="1">
                                <field name="sidebar_items" widget="one2many_list" options="{'open': true}"/>
                                <p class="oe_form_helper_text" style="font-size: 12px; opacity: 0.7;">
                                    Agrega ítems a la barra lateral de la TV (etiquetas, valores, iconos, colores).
                                </p>
                            </group>
                        </page>
                        <page string="🔻 Barra Inferior">
                            <group col="1">
                                <field name="bottom_bar_items" widget="one2many_list" options="{'open': true}"/>
                                <p class="oe_form_helper_text" style="font-size: 12px; opacity: 0.7;">
                                    Agrega ítems a la barra inferior de la TV (ticker, anuncios, información).
                                </p>
                            </group>
                        </page>
                        <page string="⚙️ Ajustes de Diseño">
                            <group col="4">
                                <field name="design_settings_id" widget="one2many_list" options="{'open': true}"/>
                                <p class="oe_form_helper_text" style="font-size: 12px; opacity: 0.7;">
                                    Configura fuentes, colores, tamaños y efectos visuales de la TV.
                                </p>
                            </group>
                        </page>
                        <page string="📧 Notificaciones">
                            <group col="4">
                                <field name="auto_notification_settings"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="📜 Historial">
                            <field name="message_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vscreens_company_search" model="ir.ui.view">
        <field name="name">vscreens.company.search</field>
        <field name="model">vscreens.company</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="rif"/>
                <filter name="active" string="Activas" domain="[('is_active','=',True)]"/>
                <filter name="inactive" string="Suspendidas" domain="[('is_active','=',False)]"/>
                <group>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_active" string="Estado" context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vscreens_company" model="ir.actions.act_window">
        <field name="name">Empresas</field>
        <field name="res_model">vscreens.company</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_vscreens_company_search"/>
    </record>
</odoo>
