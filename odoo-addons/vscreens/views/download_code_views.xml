<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vscreens_download_code_list" model="ir.ui.view">
        <field name="name">vscreens.download.code.list</field>
        <field name="model">vscreens.download.code</field>
        <field name="arch" type="xml">
            <list string="Códigos de descarga" decoration-danger="not valid_now">
                <field name="code"/>
                <field name="product_name"/>
                <field name="company_id"/>
                <field name="partner_id"/>
                <field name="uses"/>
                <field name="max_uses"/>
                <field name="expires_at"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vscreens_download_code_form" model="ir.ui.view">
        <field name="name">vscreens.download.code.form</field>
        <field name="model">vscreens.download.code</field>
        <field name="arch" type="xml">
            <form string="Código de descarga">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="code"/></h1>
                    </div>
                    <group col="4">
                        <field name="product_tmpl_id"/>
                        <field name="company_id"/>
                        <field name="partner_id"/>
                        <field name="order_id"/>
                        <field name="max_uses"/>
                        <field name="uses" readonly="1"/>
                        <field name="expires_at"/>
                        <field name="active"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vscreens_download_code" model="ir.actions.act_window">
        <field name="name">Códigos de descarga</field>
        <field name="res_model">vscreens.download.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vscreens_download_code"
              name="Códigos de descarga"
              parent="menu_vscreens_digital_download"
              action="action_vscreens_download_code"
              sequence="3"/>
</odoo>
