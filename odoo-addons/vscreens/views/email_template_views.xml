<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email Templates -->
    <record id="view_vscreens_email_template_tree" model="ir.ui.view">
        <field name="name">vscreens.email.template.tree</field>
        <field name="model">vscreens.email.template</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Email">
                <field name="name"/>
                <field name="category"/>
                <field name="subject"/>
                <field name="is_system"/>
                <field name="active"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="view_vscreens_email_template_form" model="ir.ui.view">
        <field name="name">vscreens.email.template.form</field>
        <field name="model">vscreens.email.template</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Email">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Información">
                        <group>
                            <field name="category"/>
                            <field name="is_system"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="subject"/>
                            <field name="created_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cuerpo HTML">
                            <field name="body" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vscreens_email_template" model="ir.actions.act_window">
        <field name="name">Plantillas de Email</field>
        <field name="res_model">vscreens.email.template</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_vscreens_email_template"
              name="Plantillas de Email"
              parent="vscreens.menu_vscreens_crm"
              action="action_vscreens_email_template"
              sequence="10"/>
</odoo>
