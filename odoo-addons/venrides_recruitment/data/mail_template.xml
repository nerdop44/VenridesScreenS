<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_test" model="mail.template">
        <field name="name">Reclutamiento — Enlace de test</field>
        <field name="model_id" ref="model_venrides_test_invitation"/>
        <field name="subject">VenridesCafé — Test de selección</field>
        <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
        <field name="body_html" type="html">
            <div style="margin:0;padding:0;background:#f6f1e7;font-family:Arial,Helvetica,sans-serif;color:#3b2b2b;">
                <div style="max-width:600px;margin:0 auto;padding:24px;">
                    <div style="background:#6E161E;color:#fff;padding:20px 24px;border-radius:8px 8px 0 0;">
                        <h2 style="margin:0;font-size:20px;">VenridesCafé</h2>
                        <p style="margin:4px 0 0;opacity:.85;">Vive la experiencia VenridesCafé</p>
                    </div>
                    <div style="background:#fff;padding:24px;border-radius:0 0 8px 8px;">
                        <p>Hola <strong t-out="object.applicant_id.partner_name or ''"/>:</p>
                        <p>
                            Gracias por postular a <strong t-out="object.template_id.name or ''"/>.
                            El siguiente paso es completar un test en línea.
                        </p>
                        <p style="text-align:center;margin:28px 0;">
                            <a t-att-href="object.url"
                               style="background:#6E161E;color:#fff;text-decoration:none;padding:12px 24px;border-radius:6px;display:inline-block;">
                                Iniciar el test
                            </a>
                        </p>
                        <p style="font-size:13px;color:#666;">
                            El enlace vence el <strong t-out="object.expiry_date or ''"/>.
                            Si el botón no funciona, copia y pega esta dirección en tu navegador:<br/>
                            <span t-out="object.url or ''"/>
                        </p>
                        <p style="font-size:13px;color:#666;">
                            El test es una referencia de tus conocimientos y destrezas:
                            no es eliminatorio por sí solo.
                        </p>
                    </div>
                    <p style="text-align:center;font-size:12px;color:#8a7a6a;margin-top:16px;">
                        VenridesCafé, C.A. · Barinas, Venezuela
                    </p>
                </div>
            </div>
        </field>
    </record>
</odoo>
