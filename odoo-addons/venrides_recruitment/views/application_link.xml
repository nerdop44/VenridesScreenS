<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_application_link_list" model="ir.ui.view">
        <field name="name">venrides.application.link.list</field>
        <field name="model">venrides.application.link</field>
        <field name="arch" type="xml">
            <list string="Enlaces de postulación">
                <field name="name"/>
                <field name="recipient_name"/>
                <field name="recipient_email"/>
                <field name="vacancy_id"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'submitted'"
                       decoration-warning="state == 'opened'"
                       decoration-muted="state in ('new', 'expired', 'cancelled')"/>
                <field name="applicant_id"/>
            </list>
        </field>
    </record>

    <record id="view_application_link_form" model="ir.ui.view">
        <field name="name">venrides.application.link.form</field>
        <field name="model">venrides.application.link</field>
        <field name="arch" type="xml">
            <form string="Enlace de postulación">
                <header>
                    <button name="action_open_link" type="object"
                            string="Abrir enlace" class="btn-primary"
                            invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_send_email" type="object"
                            string="Enviar por correo" invisible="not recipient_email"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state in ('submitted', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="recipient_name"/>
                            <field name="recipient_email"/>
                            <field name="vacancy_id"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="whatsapp_url" widget="url"/>
                            <field name="opened_date"/>
                            <field name="submitted_date"/>
                            <field name="applicant_id"/>
                        </group>
                    </group>
                    <field name="template_ids" widget="many2many_tags"/>
                    <div class="alert alert-info">
                        Copia el enlace y envíalo por WhatsApp al postulante. Al abrirlo,
                        llenará sus datos, su síntesis curricular y los 3 tests.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_application_link" model="ir.actions.act_window">
        <field name="name">Enlaces de postulación</field>
        <field name="res_model">venrides.application.link</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea un enlace para un postulante</p>
            <p>Comparte el enlace por WhatsApp; el postulante llena sus datos y los 3 tests.</p>
        </field>
    </record>
</odoo>
