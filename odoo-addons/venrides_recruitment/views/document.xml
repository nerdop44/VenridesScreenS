<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_document_list" model="ir.ui.view">
        <field name="name">venrides.employee.document.list</field>
        <field name="model">venrides.employee.document</field>
        <field name="arch" type="xml">
            <list string="Documentos">
                <field name="name"/>
                <field name="doc_type"/>
                <field name="applicant_id"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="expiry_date"/>
                <field name="verified"/>
            </list>
        </field>
    </record>

    <record id="view_employee_document_form" model="ir.ui.view">
        <field name="name">venrides.employee.document.form</field>
        <field name="model">venrides.employee.document</field>
        <field name="arch" type="xml">
            <form string="Documento">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="doc_type"/>
                            <field name="date"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="applicant_id"/>
                            <field name="employee_id"/>
                            <field name="verified"/>
                        </group>
                    </group>
                    <field name="attachment_id" widget="binary"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_venrides_employee_document" model="ir.actions.act_window">
        <field name="name">Expediente digital</field>
        <field name="res_model">venrides.employee.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
