<odoo>
    <record id="view_account_move_form_locve_tax" model="ir.ui.view">
        <field name="name">view.account.move.form.locve.tax</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Campos SENIAT de no deducibilidad, inyectados en la lista de lineas
                 de factura (Odoo 20 usa lista embebida + <column> en view_move_form) -->
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']" position="after">
                <field name="move_type" column_invisible="True"/>
                <field name="config_deductible_tax" column_invisible="True"/>
                <field name="not_deductible_tax" string="No Deductible" optional="hide"
                       invisible="move_type not in ('in_invoice', 'in_refund') or not config_deductible_tax"/>
            </xpath>
        </field>
    </record>
</odoo>
