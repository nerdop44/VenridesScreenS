<templates xml:space="preserve">

    <t
        t-name="l10n_ve_accountant.TaxGroupComponent"
        t-inherit="account.TaxGroupComponent"
        t-inherit-mode="extension"
        owl="1">
        <xpath expr="//tr/td[2]/t[@t-if]/t[@t-else]/span/span" position="replace">
            <span class="o_tax_group_amount_value o_tree_monetary">
                <t t-out="this.props.taxGroup.formatted_tax_group_amount"/>
            </span>
        </xpath>
        <xpath expr="//tr" position="before">
            <tr>
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label" t-out="'Total G ' + this.props.taxGroup.tax_group_name"/>
                </td>

                <td class="o_tax_group">
                    <span class="o_tax_group_amount_value o_tree_monetary">
                        <t t-out="this.props.taxGroup.formatted_tax_group_base_amount" style="white-space: nowrap;"/>
                    </span>
                </td>
            </tr>
        </xpath>
    </t>

    <t t-name="l10n_ve_tax.TaxTotalsField" t-inherit="account.TaxTotalsField" t-inherit-mode="extension" owl="1">
        <xpath expr="//table[1]/tbody[1]/t[1]" position="before">
            <tr t-if="totals.discount_amount and totals.show_discount">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Subtotal</label>
                </td>
                <td>
                    <span
                        name="subtotal"
                        class="o_tax_group_amount_value o_tree_monetary"
                        t-out="totals.formatted_subtotal"
                    />
                </td>
            </tr>
            <tr t-if="totals.discount_amount and totals.show_discount">
                <td class="o_td_label">
                    <label class="o_form_label o_tax_total_label">Discount</label>
                </td>
                <td class="o_tax_group">
                    <span
                        name="discount_amount"
                        class="o_tax_group_amount_value o_tree_monetary"
                        t-out="totals.formatted_discount_amount"
                    />
                </td>
            </tr>
        </xpath>
    </t>

    <!--
        Migracion Odoo 20:
        Este template es standalone (no t-inherit), por lo que NO hereda de
        account.TaxTotalsField y por tanto no hereda tampoco de su
        <t t-set="totals" t-value="this.totals()"/>. La version anterior usaba
        identificadores libres (totals.*, currency, readonly, invalidate,
        _onChangeTaxValueByTaxGroup), que OWL compila como ctx['totals'] y por
        tanto eran undefined: la tabla jamas se renderizaba.

        Ademas `this.totals` es un computed: se invoca como this.totals().
        Se replica el patron del nucleo (account.TaxTotalsField).
    -->
    <t t-name="l10n_ve_tax.TaxForeignTotalsField" owl="1">
        <t t-set="totals" t-value="this.totals()"/>
        <table t-if="totals" class="oe_right">
            <tbody>
                <tr t-if="totals.foreign_discount_amount and totals.show_discount">
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Subtotal</label>
                    </td>
                    <td>
                        <span
                            name="foreign_amount_untaxed"
                            class="o_tax_group_amount_value o_tree_monetary"
                            t-out="totals.foreign_formatted_subtotal"
                        />
                    </td>
                </tr>
                <tr t-if="totals.foreign_discount_amount and totals.show_discount">
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Discount</label>
                    </td>
                    <td class="o_tax_group">
                        <span
                            name="foreign_discount_amount"
                            class="o_tax_group_amount_value o_tree_monetary"
                            t-out="totals.foreign_formatted_discount_amount"
                        />
                    </td>
                </tr>
                <t t-foreach="totals.foreign_subtotals" t-as="subtotal" t-key="subtotal.name">
                    <tr>
                        <td class="o_td_label">
                            <label class="o_form_label o_tax_total_label" t-out="subtotal.name"/>
                        </td>

                        <td class="o_tree_monetary">
                            <span t-att-name="subtotal.name" style="white-space: nowrap; font-weight: bold;" t-out="subtotal.formatted_amount"/>
                        </td>
                    </tr>
                    <t t-if="totals.groups_by_foreign_subtotal and totals.groups_by_foreign_subtotal[subtotal.name]">
                        <t t-foreach="totals.groups_by_foreign_subtotal[subtotal.name]" t-as="taxGroup" t-key="taxGroup.group_key">
                            <TaxGroupComponent
                                totals="totals"
                                taxGroup="taxGroup"
                                isReadonly="this.readonly"
                                onChangeTaxGroup.bind="this._onChangeTaxValueByTaxGroup"
                                invalidate.bind="this.invalidate"
                            />
                        </t>
                    </t>
                </t>
                <tr>
                    <td class="o_td_label">
                        <label class="o_form_label o_tax_total_label">Total</label>
                    </td>

                    <td class="o_tree_monetary">
                        <span
                            name="foreign_amount_total"
                            t-att-class="totals.groups_by_subtotal and Object.keys(totals.groups_by_subtotal).length > 0 ? 'oe_subtotal_footer_separator' : ''"
                            t-out="totals.foreign_formatted_amount_total"
                            style="font-size: 1.3em; font-weight: bold; white-space: nowrap;"
                        />
                    </td>
                </tr>
            </tbody>
        </table>
    </t>
</templates>
