<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="hr_leave_form_inherit_views_ve" model="ir.ui.view">
            <field name="name">hr.leave.form.ve</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='work_entry_type_id']" position="after">
                    <field name="is_vaca" invisible="1"/>
                    <field name="vaca_disponible" invisible="not is_vaca"/>
                    <field name="dias_a_disfrutar" invisible="not is_vaca"/>
                    <field name="dias_habiles" invisible="not is_vaca"/>
                    <field name="dias_fer_desc" invisible="not is_vaca"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
