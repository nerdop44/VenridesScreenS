
<odoo>

    <record id="retention_restricted_multi_company" model="ir.access">
        <field name="name">Account Retention multi-company</field>
        <field name="model_id" ref="model_account_retention"/>
        <field name="operation">crud</field>
        <field name="domain">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>

    <record id="retention_line_restricted_multi_company" model="ir.access">
        <field name="name">Account Retention line multi-company</field>
        <field name="model_id" ref="model_account_retention_line"/>
        <field name="operation">crud</field>
        <field name="domain">
            ['|',('company_id','=',False),('company_id', 'in', company_ids)]
        </field>
    </record>

</odoo>
