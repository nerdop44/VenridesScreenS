# Copiar a /opt/vscreens/.env y completar con secretos fuertes.
# Nunca subir este archivo al repositorio.

DB_HOST=vscreens-db
DB_PORT=5432
DB_NAME=vscreens
DB_USER=vscreens
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

ODOO_ADMIN_PASSWD=CHANGE_ME_STRONG_MASTER_PASSWORD
ODOO_ADMIN_USER_PASSWORD=CHANGE_ME_ADMIN_USER_PASSWORD
ODOO_WORKERS=2
ODOO_LOG_LEVEL=info

MASTER_ADMIN_EMAIL=nerdop@gmail.com
MASTER_ADMIN_PASSWORD=CHANGE_ME_STRONG_USER_PASSWORD

MAIL_HOST=smtp.inverpave.com
MAIL_PORT=587
MAIL_USER=info.vscreens@inverpave.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_FROM="VScreenS <info.vscreens@inverpave.com>"

# Buzón dedicado para tickets (IMAP)
MAIL_SUPPORT_USER=soporte.vscreens@inverpave.com
MAIL_SUPPORT_PASSWORD=CHANGE_ME_SUPPORT_MAIL_PASSWORD
